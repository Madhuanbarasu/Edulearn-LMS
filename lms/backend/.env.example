# Copy to .env and fill in YOUR OWN values. Never commit .env.
PORT=5000

# Local MongoDB, or your own Atlas URI for real use. For automated tests use a DISPOSABLE database (see README).
MONGO_URI=mongodb://127.0.0.1:27017/edulearn_dev

# Required: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=7d

# Explicit browser origin(s) allowed to call the API (comma-separated). Wildcards are rejected.
CLIENT_URL=http://localhost:5173

# Optional
# NODE_ENV=production
# TRUST_PROXY=1                 # set when running behind a reverse proxy so rate limiting sees real IPs
# AUTH_RATE_LIMIT_MAX=20        # login/register attempts per 15 min per IP
# API_RATE_LIMIT_MAX=300        # API requests per minute per IP
# DNS_SERVERS=8.8.8.8,1.1.1.1   # original project's DNS override for Atlas SRV; set empty to disable
